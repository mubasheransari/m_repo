cat > .env <<EOF
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://miora:miora@localhost:5433/miora?schema=public
JWT_ACCESS_SECRET=$(openssl rand -hex 32)
JWT_REFRESH_SECRET=$(openssl rand -hex 32)
OTP_SECRET=$(openssl rand -hex 32)
# PUBLIC_BASE_URL is optional: only used when it is NOT localhost (production). Otherwise the request address is used.
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads
# Photo verification (mandatory). Engines: rekognition (AWS, automatic) | manual (admin review queue) | dev (approves all, development only)
REQUIRE_PHOTO_VERIFICATION=true
VERIFICATION_ENGINE=manual
PRIVATE_DIR=private
# For VERIFICATION_ENGINE=rekognition:
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# FACE_MATCH_THRESHOLD=90
ADMIN_EMAILS=your@email.com
# First admin account for the admin panel (http://localhost:4000/admin-panel/). Created/updated on every start.
ADMIN_EMAIL=admin@miora.test
ADMIN_PASSWORD=ChangeMe12345
EOF